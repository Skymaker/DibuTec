{
  "formato": "dibutec-ejercicio",
  "version": 1,
  "id": "eso1-incentro",
  "titulo": "Incentro y circunferencia inscrita",
  "nivel": "1.º ESO · 5.1, ej. 2 (2)",
  "descripcion": "Halla el incentro de un triángulo acutángulo escaleno con dos bisectrices y traza su circunferencia inscrita.",
  "papel": {
    "papel": "blanco",
    "hoja": "A4-h"
  },
  "inicial": {
    "puntos": [
      {
        "nombre": "A",
        "x": 85.0,
        "y": 172.0
      },
      {
        "nombre": "B",
        "x": 220.0,
        "y": 172.0
      },
      {
        "nombre": "C",
        "x": 140.0,
        "y": 55.0
      }
    ],
    "rectas": [
      {
        "nombre": "AB",
        "desde": "A",
        "hasta": "B"
      },
      {
        "nombre": "BC",
        "desde": "B",
        "hasta": "C"
      },
      {
        "nombre": "AC",
        "desde": "A",
        "hasta": "C"
      }
    ]
  },
  "textos": {
    "AB": "el lado AB",
    "BC": "el lado BC",
    "AC": "el lado AC",
    "c1": "el arco con centro en A",
    "c2": "el arco con centro en P1",
    "c4": "el arco con centro en B",
    "c5": "el arco con centro en Q1"
  },
  "pasos": [
    {
      "texto": "Bisectriz del ángulo A. Pincha el compás en A y traza un arco que corte a sus dos lados.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "A",
        "radio": {
          "min": 15,
          "max": 50
        },
        "cortaA": [
          "AB",
          "AC"
        ],
        "nombrar": "c1"
      }
    },
    {
      "texto": "Marca los dos cortes del arco con los lados.",
      "herramientas": [
        "lapiz"
      ],
      "objetivos": [
        {
          "tipo": "punto",
          "cruce": [
            "c1",
            "AB"
          ],
          "nombrar": "P1"
        },
        {
          "tipo": "punto",
          "cruce": [
            "c1",
            "AC"
          ],
          "nombrar": "P2"
        }
      ]
    },
    {
      "texto": "Pincha el compás en P1 y traza un arco hacia dentro del ángulo.",
      "pista": "Ábrelo más de la mitad de la distancia entre los dos puntos.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "P1",
        "radio": {
          "min": 15
        },
        "nombrar": "c2"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en P2 y traza otro arco que corte al anterior.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "P2",
        "radioComo": "c2",
        "cortaA": [
          "c2"
        ],
        "nombrar": "c3",
        "posteriorA": "c2"
      }
    },
    {
      "texto": "Marca el punto D, donde se cortan los dos arcos.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c2",
          "c3"
        ],
        "corte": false,
        "nombrar": "D"
      }
    },
    {
      "texto": "Une A con D y alarga la recta hacia dentro del triángulo: es la bisectriz del ángulo A.",
      "herramientas": [
        "regla",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "A",
          "D"
        ],
        "longitudMin": 80,
        "nombrar": "bA"
      }
    },
    {
      "texto": "Bisectriz del ángulo B. Pincha el compás en B y traza un arco que corte a sus dos lados.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "B",
        "radio": {
          "min": 15,
          "max": 50
        },
        "cortaA": [
          "AB",
          "BC"
        ],
        "nombrar": "c4",
        "posteriorA": "bA"
      }
    },
    {
      "texto": "Marca los dos cortes del arco con los lados.",
      "herramientas": [
        "lapiz"
      ],
      "objetivos": [
        {
          "tipo": "punto",
          "cruce": [
            "c4",
            "AB"
          ],
          "nombrar": "Q1"
        },
        {
          "tipo": "punto",
          "cruce": [
            "c4",
            "BC"
          ],
          "nombrar": "Q2"
        }
      ]
    },
    {
      "texto": "Pincha el compás en Q1 y traza un arco hacia dentro del ángulo.",
      "pista": "Ábrelo más de la mitad de la distancia entre los dos puntos.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "Q1",
        "radio": {
          "min": 15
        },
        "nombrar": "c5"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en Q2 y traza otro arco que corte al anterior.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "Q2",
        "radioComo": "c5",
        "cortaA": [
          "c5"
        ],
        "nombrar": "c6",
        "posteriorA": "c5"
      }
    },
    {
      "texto": "Marca el punto E, donde se cortan los dos arcos.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c5",
          "c6"
        ],
        "corte": false,
        "nombrar": "E"
      }
    },
    {
      "texto": "Une B con E y alarga la recta hacia dentro del triángulo: es la bisectriz del ángulo B.",
      "herramientas": [
        "regla",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "B",
          "E"
        ],
        "longitudMin": 80,
        "nombrar": "bB"
      }
    },
    {
      "texto": "Marca el incentro I, donde se cortan las dos bisectrices.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "bA",
          "bB"
        ],
        "nombrar": "I"
      }
    },
    {
      "texto": "Traza por I la perpendicular al lado AB con la escuadra, hasta que corte a AB.",
      "herramientas": [
        "regla",
        "escuadra",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "I"
        ],
        "perpendicularA": "AB",
        "longitudMin": 15,
        "nombrar": "p"
      }
    },
    {
      "texto": "Marca el punto T donde esa perpendicular corta a AB.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "p",
          "AB"
        ],
        "nombrar": "T"
      }
    },
    {
      "texto": "Pincha el compás en I, ábrelo hasta T y traza la circunferencia inscrita: toca a los tres lados.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "I",
        "pasaPor": [
          "T"
        ],
        "completo": true
      }
    }
  ],
  "final": "¡Muy bien! El incentro está a la misma distancia de los tres lados, por eso la circunferencia inscrita es tangente a todos."
}
