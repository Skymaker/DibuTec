  "textos": {
    "la1": "el lado horizontal de α",
    "la2": "el lado inclinado de α",
    "lb1": "el lado horizontal de β",
    "lb2": "el lado inclinado de β",
    "s1": "la semirrecta de O",
    "s2": "la semirrecta de O'",
    "c1": "el arco de α",
    "c3": "el arco grande de O",
    "c6": "el arco grande de O'"
