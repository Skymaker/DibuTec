{
  "formato": "dibutec-ejercicio",
  "version": 1,
  "id": "eso1-division-angulo-cuatro",
  "titulo": "División de un ángulo en cuatro partes",
  "nivel": "1.º ESO · 3.1, ej. 2 (1)",
  "descripcion": "Divide un ángulo de 120° en cuatro ángulos iguales trazando bisectrices sucesivas con regla y compás.",
  "papel": {
    "papel": "blanco",
    "hoja": "A4-h"
  },
  "inicial": {
    "puntos": [
      {
        "nombre": "V",
        "x": 75.0,
        "y": 165.0
      }
    ],
    "rectas": [
      {
        "nombre": "l1",
        "desde": "V",
        "x2": 160.0,
        "y2": 165.0
      },
      {
        "nombre": "l2",
        "desde": "V",
        "x2": 32.5,
        "y2": 91.388
      }
    ]
  },
  "textos": {
    "l1": "el lado horizontal",
    "l2": "el lado inclinado",
    "c1": "el primer arco",
    "c2": "el arco con centro en P",
    "b1": "la primera bisectriz",
    "c4": "el arco con centro en P",
    "c6": "el arco con centro en Q"
  },
  "pasos": [
    {
      "texto": "Pincha el compás en V y traza un arco que corte a los dos lados del ángulo.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "V",
        "radio": {
          "min": 25,
          "max": 60
        },
        "cortaA": [
          "l1",
          "l2"
        ],
        "nombrar": "c1"
      }
    },
    {
      "texto": "Marca los dos puntos donde el arco corta a los lados: P en el lado horizontal y Q en el inclinado.",
      "herramientas": [
        "lapiz"
      ],
      "objetivos": [
        {
          "tipo": "punto",
          "cruce": [
            "c1",
            "l1"
          ],
          "nombrar": "P"
        },
        {
          "tipo": "punto",
          "cruce": [
            "c1",
            "l2"
          ],
          "nombrar": "Q"
        }
      ]
    },
    {
      "texto": "Pincha el compás en P y traza un arco hacia dentro del ángulo.",
      "pista": "Ábrelo más de la mitad de la distancia entre los dos puntos.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "P",
        "radio": {
          "min": 15
        },
        "nombrar": "c2"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en Q y traza otro arco que corte al anterior.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "Q",
        "radioComo": "c2",
        "cortaA": [
          "c2"
        ],
        "nombrar": "c3",
        "posteriorA": "c2"
      }
    },
    {
      "texto": "Marca el punto D, donde se cortan los dos arcos.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c2",
          "c3"
        ],
        "corte": false,
        "nombrar": "D"
      }
    },
    {
      "texto": "Une V con D: es la bisectriz b1, que divide el ángulo en dos de 60°. Hazla más larga que el arco.",
      "herramientas": [
        "regla",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "V",
          "D"
        ],
        "angulo": {
          "con": "l1",
          "grados": 60
        },
        "longitudMin": 70,
        "nombrar": "b1"
      }
    },
    {
      "texto": "Marca el punto M donde la bisectriz corta al primer arco.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c1",
          "b1"
        ],
        "corte": {
          "x": 97.5,
          "y": 126.029
        },
        "nombrar": "M"
      }
    },
    {
      "texto": "Pincha el compás en P y traza un arco hacia dentro del ángulo.",
      "pista": "Ábrelo más de la mitad de la distancia entre los dos puntos.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "P",
        "radio": {
          "min": 15
        },
        "nombrar": "c4",
        "posteriorA": "M"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en M y traza otro arco que corte al anterior.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "M",
        "radioComo": "c4",
        "cortaA": [
          "c4"
        ],
        "nombrar": "c5",
        "posteriorA": "c4"
      }
    },
    {
      "texto": "Marca el punto E, donde se cortan los dos arcos.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c4",
          "c5"
        ],
        "corte": false,
        "nombrar": "E"
      }
    },
    {
      "texto": "Une V con E: es la bisectriz b2 del ángulo de abajo (30°).",
      "herramientas": [
        "regla",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "V",
          "E"
        ],
        "angulo": {
          "con": "l1",
          "grados": 30
        },
        "longitudMin": 60,
        "nombrar": "b2"
      }
    },
    {
      "texto": "Pincha el compás en Q y traza un arco hacia dentro del ángulo.",
      "pista": "Ábrelo más de la mitad de la distancia entre los dos puntos.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "Q",
        "radio": {
          "min": 15
        },
        "nombrar": "c6",
        "posteriorA": "b2"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en M y traza otro arco que corte al anterior.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "M",
        "radioComo": "c6",
        "cortaA": [
          "c6"
        ],
        "nombrar": "c7",
        "posteriorA": "c6"
      }
    },
    {
      "texto": "Marca el punto F, donde se cortan los dos arcos.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c6",
          "c7"
        ],
        "corte": false,
        "nombrar": "F"
      }
    },
    {
      "texto": "Une V con F: es la bisectriz b3 del ángulo de arriba.",
      "herramientas": [
        "regla",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "V",
          "F"
        ],
        "angulo": {
          "con": "l1",
          "grados": 90
        },
        "longitudMin": 60,
        "nombrar": "b3"
      }
    }
  ],
  "final": "¡Muy bien! El ángulo de 120° ha quedado dividido en cuatro ángulos iguales de 30°."
}
