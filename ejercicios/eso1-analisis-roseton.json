            "A",
            "B"
          ],
          [
            "B",
            "C"
          ]
        ]
      }
    },
    {
      "texto": "Mediatriz de AB. Pincha el compás en A, ábrelo algo más de la mitad de AB y traza un arco grande por encima y por debajo.",
      "pista": "Arrastra la mina para abrir el compás y gira el asa para trazar.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "A",
        "radio": {
          "min": 59.1
        },
        "nombrar": "abk1"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en B y traza otro arco que corte al anterior por los dos lados.",
      "pista": "Arrastra el compás por la punta seca: así se mueve sin cambiar la abertura.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "B",
        "radioComo": "abk1",
        "cortaA": [
