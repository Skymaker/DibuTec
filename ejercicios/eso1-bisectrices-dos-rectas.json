{
  "formato": "dibutec-ejercicio",
  "version": 1,
  "id": "eso1-bisectrices-dos-rectas",
  "titulo": "Bisectrices de dos rectas que se cortan",
  "nivel": "1.º ESO · 4.1, ej. 2",
  "descripcion": "Traza las bisectrices de los cuatro ángulos que forman dos rectas que se cortan, comprueba que son perpendiculares y traza los puntos que distan 1,5 cm de una de ellas.",
  "papel": {
    "papel": "blanco",
    "hoja": "A4-h"
  },
  "inicial": {
    "puntos": [
      {
        "nombre": "V",
        "x": 148.5,
        "y": 110.0
      }
    ],
    "rectas": [
      {
        "nombre": "r1",
        "x1": 45.134,
        "y1": 147.622,
        "x2": 251.866,
        "y2": 72.378
      },
      {
        "nombre": "r2",
        "x1": 197.254,
        "y1": 179.628,
        "x2": 99.746,
        "y2": 40.372
      }
    ]
  },
  "textos": {
    "r1": "la recta r1",
    "r2": "la recta r2",
    "c1": "la circunferencia",
    "c2": "el arco con centro en 1",
    "b1": "la primera bisectriz",
    "c4": "el arco con centro en 2",
    "p": "la perpendicular por X",
    "c6": "el arco con centro en X"
  },
  "pasos": [
    {
      "texto": "Traza una circunferencia con centro en V que corte a las dos rectas.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "V",
        "radio": {
          "min": 25,
          "max": 70
        },
        "completo": true,
        "nombrar": "c1"
      }
    },
    {
      "texto": "Marca los cuatro puntos donde la circunferencia corta a las rectas.",
      "herramientas": [
        "lapiz"
      ],
      "objetivos": [
        {
          "tipo": "punto",
          "cruce": [
            "c1",
            "r1"
          ],
          "cantidad": 2,
          "nombrar": [
            "1",
            "3"
          ]
        },
        {
          "tipo": "punto",
          "cruce": [
            "c1",
            "r2"
          ],
          "cantidad": 2,
          "nombrar": [
            "2",
            "4"
          ]
        }
      ]
    },
    {
      "texto": "Pincha el compás en 1 y traza un arco hacia dentro del ángulo.",
      "pista": "Ábrelo más de la mitad de la distancia entre los dos puntos.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "1",
        "radio": {
          "min": 15
        },
        "nombrar": "c2",
        "posteriorA": "4"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en 2 y traza otro arco que corte al anterior.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "2",
        "radioComo": "c2",
        "cortaA": [
          "c2"
        ],
        "nombrar": "c3",
        "posteriorA": "c2"
      }
    },
    {
      "texto": "Marca el punto D, donde se cortan los dos arcos.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c2",
          "c3"
        ],
        "corte": false,
        "nombrar": "D"
      }
    },
    {
      "texto": "Une V con D y prolonga la recta al otro lado de V: es la bisectriz de ese ángulo y también la de su opuesto por el vértice.",
      "herramientas": [
        "regla",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "V",
          "D"
        ],
        "longitudMin": 120,
        "nombrar": "b1"
      }
    },
    {
      "texto": "Pincha el compás en 2 y traza un arco hacia dentro del ángulo.",
      "pista": "Ábrelo más de la mitad de la distancia entre los dos puntos.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "2",
        "radio": {
          "min": 15
        },
        "nombrar": "c4",
        "posteriorA": "b1"
      }
    },
    {
      "texto": "Sin cambiar la abertura, pincha en 3 y traza otro arco que corte al anterior.",
      "herramientas": [
        "compas"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "3",
        "radioComo": "c4",
        "cortaA": [
          "c4"
        ],
        "nombrar": "c5",
        "posteriorA": "c4"
      }
    },
    {
      "texto": "Marca el punto E, donde se cortan los dos arcos.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c4",
          "c5"
        ],
        "corte": false,
        "nombrar": "E"
      }
    },
    {
      "texto": "Une V con E y prolóngala también: es la otra bisectriz. Comprueba que es perpendicular a la primera.",
      "herramientas": [
        "regla",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "V",
          "E"
        ],
        "perpendicularA": "b1",
        "longitudMin": 120,
        "nombrar": "b2"
      }
    },
    {
      "texto": "Ahora, los puntos a 1,5 cm de r1. Marca un punto X sobre r1, lejos de V.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "sobre": "r1",
        "posteriorA": "b2",
        "nombrar": "X"
      }
    },
    {
      "texto": "Traza por X la perpendicular a r1 con la escuadra.",
      "herramientas": [
        "regla",
        "escuadra",
        "lapiz"
      ],
      "objetivo": {
        "tipo": "recta",
        "pasaPor": [
          "X"
        ],
        "perpendicularA": "r1",
        "longitudMin": 40,
        "nombrar": "p"
      }
    },
    {
      "texto": "Pincha el compás en X, ábrelo 1,5 cm y traza una circunferencia que corte a la perpendicular por los dos lados.",
      "herramientas": [
        "compas",
        "regla"
      ],
      "objetivo": {
        "tipo": "arco",
        "centro": "X",
        "radio": 15,
        "cortaA": [
          {
            "elemento": "p",
            "cortes": 2
          }
        ],
        "nombrar": "c6"
      }
    },
    {
      "texto": "Marca los dos cortes.",
      "herramientas": [
        "lapiz"
      ],
      "objetivo": {
        "tipo": "punto",
        "cruce": [
          "c6",
          "p"
        ],
        "cantidad": 2,
        "nombrar": [
          "T1",
          "T2"
        ]
      }
    },
    {
      "texto": "Traza por cada corte la paralela a r1. Son los puntos del plano que distan 1,5 cm de r1.",
      "herramientas": [
        "escuadra",
        "cartabon",
        "lapiz"
      ],
      "objetivos": [
        {
          "tipo": "recta",
          "pasaPor": [
            "T1"
          ],
          "paralelaA": "r1",
          "longitudMin": 100
        },
        {
          "tipo": "recta",
          "pasaPor": [
            "T2"
          ],
          "paralelaA": "r1",
          "longitudMin": 100
        }
      ]
    }
  ],
  "final": "¡Muy bien! Las dos bisectrices son perpendiculares, y el lugar geométrico de los puntos a 1,5 cm de una recta son dos paralelas a ella."
}
